# Public application URL (set the canonical HTTPS URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — safe public values reserved for the backend milestone
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values — never expose these in NEXT_PUBLIC_* variables
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=

# Optional rewards partner integration
REWARDS_PROVIDER_API_URL=
REWARDS_PROVIDER_API_KEY=
